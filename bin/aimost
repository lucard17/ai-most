#!/bin/sh
# aimost from this directory without installing anything (the Claude Code plugin, a plain checkout):
# the package is in ../src next to this script. A pip-installed `aimost` on PATH works the same.
root=$(cd "$(dirname "$0")/.." && pwd)
PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec "${AIMOST_PYTHON:-python3}" -m aimost "$@"
