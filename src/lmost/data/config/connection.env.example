# A connection to a Mattermost server — ~/.config/lmost/connections/<name>.env (mode 0600). Keys: lmost/connections.py.
# Secrets (bot tokens, EDGE_SECRET) never go into this file's template or into git: take your bot's token with the chat
# command `/bot-token <bot>` (only you see the answer) and your button key with `/bot-token key`.
URL=https://chat.example.org
OWNER=<your chat login>               # your words are orders to your bots; a person's bot is named <OWNER>-<role>
TEAM=<team name>
SESSIONS_CWD=<absolute path>          # sessions started in this directory or below are admitted to the chat
# SESSIONS=deployer,review-*          # admitted by name on top of SESSIONS_CWD (or "*")
# EXCLUDE=scratch                     # never admitted, even under SESSIONS_CWD
# RELAY=<OWNER>-relay                 # a session without a bot posts through it — only into your DM, signed
# CO_OWNERS=deployer:<login>          # this login's words weigh as yours for that role only
# CONFIRMERS=deployer:<login>         # who else may press that role's ✅
EDGE_KEY_ID=<from /bot-token key>     # id of your button key
EDGE_SECRET=<from /bot-token key>     # your button key: signs question and confirmation buttons on your bots' posts
EDGE_PUBLIC=<edge address as the chat server sees it, host:port or URL>
PRIVATE_GUARD=on                      # a post matching ~/.config/lmost/private-patterns is not sent (exit code 5)
# PROGRESS=off                        # no progress post in direct messages
